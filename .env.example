# =====================================================================
# USDT Payment Verification & Reconciliation System - configuration
# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored and must NEVER be committed.
#
# SECURITY: this system is NON-CUSTODIAL and WATCH-ONLY.
# It never needs, asks for, or stores a private key or seed phrase.
# If any guide or person asks you to put one here: STOP. It is wrong.
# =====================================================================

# ---- Mode ----
# demo    = simulated chain + seeded data, no wallets or API keys needed
# testnet = TRON Nile / Arbitrum Sepolia
# mainnet = read-only watching of public mainnet data (optional, clearly labelled)
APP_MODE=demo
NODE_ENV=development
PORT=3000

# ---- Database ----
DATABASE_URL=file:./data/app.db

# ---- Admin dashboard auth ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string
ADMIN_USERNAME=admin
# Plain password is only used once by the seed script to create a bcrypt/argon2 hash.
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password

# ---- Merchant REST API ----
MERCHANT_API_KEY=replace_with_a_long_random_string

# ---- Watch-only receiving addresses (PUBLIC addresses only, comma-separated) ----
TRON_WATCH_ADDRESSES=
EVM_WATCH_ADDRESSES=

POLL_INTERVAL_SECONDS=30

# ---- TRON (TronGrid) ----
# USDT contract is chosen automatically from src/chains/tokens.ts (verified on-chain):
#   testnet -> Nile test USDT, mainnet -> official Tether TRC20 USDT.
# Leave empty to use the default (testnet: https://nile.trongrid.io, mainnet: https://api.trongrid.io)
TRONGRID_API_URL=
# Free key from https://www.trongrid.io/ (strongly recommended: anonymous use hits HTTP 429)
TRONGRID_API_KEY=
TRON_CONFIRMATIONS=19
# Optional: block to start from on the very first run (default: current block)
TRON_START_BLOCK=

# ---- EVM (Arbitrum) ----
# mainnet: Arbitrum One RPC, e.g. https://arb1.arbitrum.io/rpc (public) or your Alchemy URL
# testnet: Arbitrum Sepolia RPC, e.g. https://sepolia-rollup.arbitrum.io/rpc
EVM_RPC_URL=
EVM_CONFIRMATIONS=20
EVM_START_BLOCK=
EVM_MAX_BLOCKS_PER_POLL=2000
# TESTNET ONLY: there is NO official USDT on Arbitrum Sepolia. If you deploy your own
# test ERC20 (from your own wallet, outside this project), put its address here.
# It is clearly labelled UNVERIFIED in logs and the dashboard.
EVM_UNVERIFIED_TEST_TOKEN=

# ---- Payment matching ----
ORDER_EXPIRY_MINUTES=30
# Tolerances in token base units (USDT has 6 decimals: 1000 = 0.001 USDT)
UNDERPAY_TOLERANCE_UNITS=0
OVERPAY_TOLERANCE_UNITS=0
# How long an expired order's unique amount stays reserved, to recognise late payments
LATE_RESERVATION_MINUTES=1440

# ---- Telegram (optional) ----
# Create a bot with @BotFather and paste its token. Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=
# Your bot's username WITHOUT @ (used to build payer links t.me/<username>?start=<order>)
TELEGRAM_BOT_USERNAME=
# Your own numeric chat id (message @userinfobot to see it). Receives admin alerts.
TELEGRAM_ADMIN_CHAT_ID=

# ---- Merchant webhook (optional, HMAC-SHA256 signed) ----
# https:// only (http:// allowed for localhost testing). Leave empty to disable.
WEBHOOK_URL=
# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
