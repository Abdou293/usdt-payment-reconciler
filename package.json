{
  "name": "usdt-payment-reconciler",
  "version": "0.1.0",
  "description": "Non-custodial, watch-only USDT payment verification and reconciliation system (TRON TRC20 + EVM). Portfolio project.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "node scripts/enable-git-hooks.mjs",
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:secrets": "gitleaks dir . --config .gitleaks.toml --redact --no-banner",
    "scan:history": "gitleaks git . --config .gitleaks.toml --redact --no-banner",
    "scan:all": "npm run scan:secrets && npm run scan:history",
    "watch": "npm run dev",
    "verify:contracts": "tsx scripts/verify-token-contracts.ts",
    "record:fixtures": "tsx scripts/record-fixtures.ts",
    "e2e:readonly": "tsx scripts/e2e-readonly.ts",
    "dashboard:install": "npm --prefix dashboard ci",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "build:all": "npm run build && npm run dashboard:build",
    "build:render": "npm ci --include=dev && npm run build && npm --prefix dashboard ci --include=dev && npm run dashboard:build"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "grammy": "^1.48.0",
    "zod": "^4.6.7"
  }
}
